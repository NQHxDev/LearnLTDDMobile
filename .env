# Cờ môi trường: 'development' hoặc 'production'
# - development: Dùng localhost (kết hợp cắm dây cáp ADB reverse)
# - production : Dùng server production thật
ENVIRONMENT=development

# Cấu hình Base URL cho từng môi trường:
DEV_API_URL=http://localhost:5057/api
PROD_API_URL=https://mobile.zeion.online/api

# Tuỳ chọn: Ghi đè trực tiếp Base URL (để trống nếu muốn tự động lấy theo cờ ENVIRONMENT ở trên)
BASE_API_URL=
